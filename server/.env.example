# Server port
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep_kit

# Secret used to sign session JWTs stored in the httpOnly session cookie.
# Generate a long random string for real deployments, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API with credentials (cookies).
CORS_ORIGIN=http://localhost:3000

# Google Gemini API key (https://aistudio.google.com/apikey) — free tier.
# Backend-only. Never exposed to the browser.
GEMINI_API_KEY=
# "gemini-flash-latest" is a rolling alias to Google's current default
# free-tier flash model, so this keeps working as Gemini model versions
# are deprecated/replaced over time. Pin an exact version (e.g.
# gemini-2.5-flash) if you want reproducible behaviour instead.
GEMINI_MODEL=gemini-flash-latest

# Coverage / crawling / fetching tuning (sensible defaults shown).
MAX_COVERAGE_PASSES=3
CRAWL_MAX_PAGES=12
CRAWL_CONCURRENCY=3
FETCH_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=3000000

# When true, allows fetching localhost / private-network company URLs
# (used by the batch evaluator against local fixture servers, and by local
# dev). Defaults to true outside production, false in production — only set
# this explicitly if you need to override that default.
# ALLOW_PRIVATE_NETWORK_TARGETS=false

# Concurrency for the batch evaluate script (npm run evaluate).
EVALUATE_CONCURRENCY=2
